# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=civicactionai-super-secret-jwt-key-2026

# Database Connection (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/civicactionai

# AI Engine (Google Gemini API)
# Get a free key at https://aistudio.google.com/
# If omitted, system seamlessly activates deterministic civic fallback intelligence
GEMINI_API_KEY=

# Optional Cloudinary Configuration for Image Storage (falls back to local uploads directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
